<% content_for :title, "Nueva contraseña | MenuQr" %>

<div class="mb-8 space-y-1">
  <h1 class="text-2xl font-bold">Crea una nueva contraseña</h1>
  <p class="text-sm text-foreground/60">Al guardarla se cerrarán tus sesiones abiertas.</p>
</div>

<%= form_with url: password_path(params[:token]), method: :put, class: "w-full space-y-5" do %>
  <%= render Password::Component.new(
    label: "Nueva contraseña",
    name: "password",
    id: "password",
    placeholder: "••••••••",
    required: true,
    autocomplete: "new-password",
  ) %>

  <%= render Input::Component.new(
    name: "password_confirmation",
    type: :password,
    label: "Confirmar contraseña",
    placeholder: "••••••••",
    required: true,
    autocomplete: "new-password",
    maxlength: 72,
  ) %>

  <%= render Button::Component.new(text: "Guardar contraseña", type: "submit", full_width: true) %>
<% end %>
