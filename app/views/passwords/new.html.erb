<% content_for :title, "Recuperar contraseña | MenuQr" %>

<div class="mb-8 space-y-1">
  <h1 class="text-2xl font-bold">¿Olvidaste tu contraseña?</h1>
  <p class="text-sm text-foreground/60">Ingresa tu correo y te enviaremos un enlace para restablecerla.</p>
</div>

<%= form_with url: passwords_path, class: "w-full space-y-6" do %>
  <%= render Input::Component.new(
    name: "email_address",
    type: :email,
    value: params[:email_address],
    label: "Correo Electrónico",
    placeholder: "tu@email.com",
    required: true,
    autofocus: true,
    autocomplete: "username",
  ) %>

  <%= render Button::Component.new(text: "Enviar instrucciones", type: "submit", full_width: true) %>
<% end %>

<p class="mt-6 text-center text-sm text-foreground/60">
  ¿La recordaste?
  <%= link_to "Inicia sesión", new_session_path, class: "font-medium text-primary hover:text-primary/80" %>
</p>
