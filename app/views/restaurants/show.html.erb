<% content_for :title, "Menú · #{@restaurant.name}" %>
<% og_image = @restaurant.banner.attached? ? @restaurant.banner.variant(:wide) : (@restaurant.logo.variant(:thumb) if @restaurant.logo.attached?) %>

<% content_for :head do %>
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= @restaurant.name %>">
  <meta property="og:url" content="<%= public_menu_url(@restaurant) %>">

  <% if @restaurant.description.present? %>
    <meta property="og:description" content="<%= @restaurant.description %>">
    <meta name="description" content="<%= @restaurant.description %>">
  <% end %>

  <% if og_image %>
    <meta property="og:image" content="<%= rails_representation_url(og_image) %>">
  <% end %>
<% end %>

<% cache @restaurant do %>
  <% show_tabs = @categories.size > 1 %>

  <div class="min-h-screen bg-background" data-controller="menu-tabs">
    <header class="relative isolate overflow-hidden bg-secondary text-secondary-foreground">
      <% if @restaurant.banner.attached? %>
        <%= image_tag @restaurant.banner.variant(:wide), alt: "", class: "absolute inset-0 -z-10 size-full object-cover" %>
        <div class="absolute inset-0 -z-10 bg-secondary/65" aria-hidden="true"></div>
      <% end %>

      <div class="mx-auto flex max-w-5xl flex-col items-center px-6 pt-12 pb-8 text-center">
        <% if @restaurant.logo.attached? %>
          <%= image_tag @restaurant.logo.variant(:thumb), alt: "Logo de #{@restaurant.name}", class: "size-20 rounded-full bg-background object-cover ring-4 ring-secondary-foreground/20" %>
        <% else %>
          <span
            class="
              flex size-20 items-center justify-center rounded-full bg-background font-serif text-3xl font-bold
              text-foreground ring-4 ring-secondary-foreground/20
            "
            aria-hidden="true"
          >
            <%= @restaurant.name.first.upcase %>
          </span>
        <% end %>

        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-balance sm:text-5xl"><%= @restaurant.name %></h1>

        <% if @restaurant.description.present? %>
          <p class="mt-3 max-w-md text-sm text-pretty text-secondary-foreground/85 sm:text-base">
            <%= @restaurant.description %>
          </p>
        <% end %>

        <% if @restaurant.hours.present? || @restaurant.address.present? %>
          <ul class="mt-5 flex flex-wrap justify-center gap-2 text-sm font-medium">
            <% [["clock.svg", @restaurant.hours], ["map_pin.svg", @restaurant.address]].each do |icon, text| %>
              <% next if text.blank? %>

              <li class="flex items-center gap-1.5 rounded-full bg-secondary-foreground/15 px-4 py-1.5 backdrop-blur">
                <%= render_svg(icon, styles: "size-4 shrink-0") %>
                <%= text %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </header>

    <% if show_tabs %>
      <div class="sticky top-0 z-20 border-b border-border bg-background/95 backdrop-blur">
        <nav class="mx-auto max-w-5xl" aria-label="Categorías del menú">
          <div
            class="flex [scrollbar-width:none] gap-2 overflow-x-auto px-4 py-3 [&::-webkit-scrollbar]:hidden"
            data-menu-tabs-target="bar"
          >
            <% @categories.each_with_index do |category, index| %>
              <%= link_to category.name, "##{dom_id(category)}",
                class: "shrink-0 rounded-full border border-border bg-card px-4 py-2 text-sm font-medium whitespace-nowrap text-foreground/70 transition-colors data-active:border-primary data-active:bg-primary data-active:text-primary-foreground",
                aria: { current: (true if index.zero?) },
                data: { menu_tabs_target: "tab", action: "menu-tabs#select", active: (true if index.zero?) } %>
            <% end %>
          </div>
        </nav>
      </div>
    <% end %>

    <main class="mx-auto max-w-5xl px-4 pt-5 pb-12">
      <% if @categories.empty? %>
        <div
          class="
            flex flex-col items-center gap-2 rounded-lg border border-dashed border-border bg-card px-6 py-16
            text-center
          "
        >
          <p class="font-semibold text-foreground">Estamos preparando el menú</p>
          <p class="text-sm text-foreground/60">Vuelve pronto para ver nuestros platillos.</p>
        </div>
      <% else %>
        <div class="space-y-10">
          <% @categories.each do |category| %>
            <section id="<%= dom_id(category) %>" class="scroll-mt-32" data-menu-tabs-target="section">
              <% if show_tabs %>
                <h2 class="mb-4 flex items-baseline gap-2 text-xl font-bold tracking-tight text-foreground">
                  <%= category.name %>
                  <span class="text-sm font-medium text-foreground/50"><%= category.items.size %></span>
                </h2>
              <% end %>

              <div class="grid grid-flow-row-dense grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
                <%= render partial: "item", collection: category.items, as: :item %>
              </div>
            </section>
          <% end %>
        </div>
      <% end %>
    </main>

    <footer class="mx-auto max-w-5xl border-t border-border px-4 pt-6 pb-8 text-center text-xs text-foreground/40">
      <p><%= @restaurant.name %></p>

      <%= link_to root_url(host: Rails.configuration.x.app_host),
        class: "mt-3 inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 transition-colors hover:text-foreground/70",
        target: "_blank", rel: "noopener" do %>
        Menú creado con
        <span class="flex size-4 items-center justify-center rounded bg-foreground/40 text-background"><%= render_svg("qr_code.svg", styles: "size-3") %></span>
        <span class="font-semibold">MenuQr</span>
      <% end %>

      <p class="mt-1">
        ¿Tienes un restaurante?
        <%= link_to "Crea tu menú gratis", root_url(host: Rails.configuration.x.app_host),
          class: "font-medium underline underline-offset-2 hover:text-foreground/70", target: "_blank", rel: "noopener" %>
      </p>
    </footer>
  </div>
<% end %>
