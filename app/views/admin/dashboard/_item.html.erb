<%# locals: (item:) %>
<li id="<%= dom_id(item) %>" class="flex items-center gap-3 px-4 py-4 md:gap-4 md:px-5">
  <% if item.images.attached? %>
    <%= image_tag item.images.first.variant(:thumb), alt: "", class: "size-12 shrink-0 rounded-md bg-primary/5 object-cover" %>
  <% else %>
    <span class="flex size-12 shrink-0 items-center justify-center rounded-md bg-primary/5 font-serif text-lg text-primary/40" aria-hidden="true">
      <%= item.name.first.upcase %>
    </span>
  <% end %>

  <%= tag.div class: tw("min-w-0 flex-1 transition-opacity", ("opacity-50" unless item.available?)) do %>
    <div class="flex items-center gap-2">
      <p class="truncate text-sm font-medium text-foreground"><%= item.name %></p>

      <% unless item.available? %>
        <span class="shrink-0 rounded-full bg-foreground/5 px-2 py-0.5 text-xs font-medium text-foreground/70">Oculto</span>
      <% end %>
    </div>

    <% if item.description.present? %>
      <p class="mt-0.5 line-clamp-1 text-sm text-foreground/60"><%= item.description %></p>
    <% end %>
  <% end %>

  <p class="shrink-0 text-sm font-semibold tabular-nums text-foreground"><%= format_price(item) %></p>

  <%= button_to admin_item_availability_path(item),
    method: item.available? ? :delete : :post,
    form_class: "flex shrink-0",
    role: "switch",
    title: item.available? ? "Ocultar del menú" : "Mostrar en el menú",
    aria: { checked: item.available?, label: "Mostrar #{item.name} en el menú" },
    class: tw(
      "relative inline-flex h-6 w-11 cursor-pointer items-center rounded-full transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring",
      item.available? ? "bg-primary" : "bg-input"
    ) do %>
    <%= tag.span class: tw(
      "pointer-events-none inline-block size-5 rounded-full bg-background transition-transform",
      item.available? ? "translate-x-5.5" : "translate-x-0.5"
    ) %>
  <% end %>

  <%= render Button::Component.new(
    variant: :ghost,
    size: :sm,
    icon_only: true,
    href: edit_admin_item_path(item),
    icon: render_svg("pencil.svg", styles: "size-full"),
    title: "Editar",
    aria: { label: "Editar #{item.name}" },
  ) %>
</li>
