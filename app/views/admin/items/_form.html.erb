<%# locals: (item:, categories:, tags:) %>
<%= form_with(model: [:admin, item], class: "mx-auto w-full max-w-xl space-y-6") do |form| %>
  <% if item.errors.any? %>
    <div class="rounded-xl border border-destructive/30 bg-destructive/10 p-4 text-sm text-destructive" role="alert">
      <p class="font-medium">
        No se pudo guardar el platillo (<%= pluralize(item.errors.count, "error", "errores") %>)
      </p>

      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="flex flex-col gap-5 rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8">
    <%= render Input::Component.new(
      name: "item[name]",
      type: :text,
      value: item.name,
      label: "Nombre",
      placeholder: "Ej. Tacos al pastor",
      required: true,
    ) %>

    <div class="space-y-2">
      <%= form.label :description, "Descripción", class: "block text-sm font-medium text-foreground" %>

      <%= form.text_area :description,
        rows: 3,
        placeholder: "Ingredientes, porción o lo que haga único al platillo",
        class: "block min-h-24 w-full resize-y rounded-lg border border-input bg-background px-3 py-2 text-sm text-foreground placeholder:text-foreground/50 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-50" %>
    </div>

    <%= render Input::Component.new(
      name: "item[price]",
      type: :number,
      value: (format("%.2f", item.price) if item.price),
      label: "Precio (MXN)",
      placeholder: "0.00",
      required: true,
      min: "0.01",
      step: "0.01",
      inputmode: "decimal",
    ) %>

    <% new_category_name = params.dig(:item, :new_category_name).presence %>
    <div data-controller="inline-edit">
      <div class="space-y-2" data-inline-edit-target="view" <%= "hidden" if new_category_name %>>
        <div class="flex items-center justify-between gap-2">
          <label for="item_category_id" class="text-sm font-medium text-foreground">
            Categoría <span class="ml-0.5 text-destructive" aria-hidden="true">*</span>
          </label>

          <button type="button" class="cursor-pointer text-sm font-medium text-primary hover:underline" data-action="inline-edit#edit">
            + Nueva categoría
          </button>
        </div>

        <%= render Select::Component.new(
          name: "item[category_id]",
          collection: categories,
          selected: item.category_id,
          required: true,
          disabled: new_category_name.present?,
        ) %>
      </div>

      <div class="space-y-2" data-inline-edit-target="edit" <%= "hidden" unless new_category_name %>>
        <div class="flex items-center justify-between gap-2">
          <label for="item_new_category_name" class="text-sm font-medium text-foreground">
            Nueva categoría <span class="ml-0.5 text-destructive" aria-hidden="true">*</span>
          </label>

          <button type="button" class="cursor-pointer text-sm font-medium text-foreground/60 hover:text-foreground hover:underline" data-action="inline-edit#cancel">
            Cancelar
          </button>
        </div>

        <%= render Input::Component.new(
          name: "item[new_category_name]",
          value: new_category_name,
          placeholder: "Ej. Bebidas",
          required: true,
          disabled: new_category_name.nil?,
          maxlength: 50,
          data: { action: "keydown.esc->inline-edit#cancel" },
        ) %>
        <p class="text-xs text-foreground/60">Se crea al guardar el platillo. Puedes ordenarla después en Categorías.</p>
      </div>
    </div>

    <fieldset class="space-y-2">
      <div class="flex items-center justify-between gap-2">
        <legend class="text-sm font-medium text-foreground">Etiquetas</legend>
        <%= link_to "Administrar", admin_tags_path, class: "text-sm font-medium text-primary hover:underline" %>
      </div>
      <%= hidden_field_tag "item[tag_ids][]", "", id: nil %>

      <% if tags.any? %>
        <div class="flex flex-wrap gap-2">
          <% tags.each do |option| %>
            <label
              class="
                flex cursor-pointer items-center gap-2 rounded-full border border-border bg-background px-3 py-1.5
                text-sm has-checked:border-primary has-checked:bg-primary has-checked:text-primary-foreground
                has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-ring
              "
            >
              <%= check_box_tag "item[tag_ids][]", option.id, item.tags.include?(option), id: "item_tag_#{option.id}", class: "sr-only" %>
              <%= option.name %>
            </label>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-foreground/60">Aún no tienes etiquetas. Créalas en Administrar.</p>
      <% end %>
    </fieldset>

    <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-border bg-background p-4">
      <%= form.check_box :featured, class: "size-4 rounded border-input accent-primary" %>

      <span class="space-y-0.5">
        <span class="block text-sm font-medium text-foreground">Destacado</span>
        <span class="block text-xs text-foreground/60">Se muestra primero y más grande en tu menú</span>
      </span>
    </label>

    <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-border bg-background p-4">
      <%= form.check_box :available, class: "size-4 rounded border-input accent-primary" %>

      <span class="space-y-0.5">
        <span class="block text-sm font-medium text-foreground">Disponible</span>
        <span class="block text-xs text-foreground/60">Desmárcalo para ocultarlo del menú sin borrarlo</span>
      </span>
    </label>
  </section>

  <section
    class="flex flex-col gap-4 rounded-2xl border border-border bg-card p-6 sm:p-8"
    data-controller="image-preview"
    data-image-preview-max-files-value="<%= Item::MAX_IMAGES %>"
    data-image-preview-max-size-value="<%= Item::MAX_IMAGE_SIZE %>"
    data-image-preview-types-value="<%= Item::IMAGE_TYPES.to_json %>"
  >
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-sm font-medium text-foreground">
          Fotos
          <% if item.new_record? %>
            <span class="ml-0.5 text-destructive">*</span>
          <% end %>
        </h2>
        <p class="text-xs text-foreground/60">Hasta <%= Item::MAX_IMAGES %> fotos · la primera es la principal</p>
      </div>

      <span class="text-xs font-medium tabular-nums text-foreground/60" data-image-preview-target="counter"></span>
    </div>

    <div class="flex flex-wrap gap-3" data-image-preview-target="list">
      <% item.images.select { |image| image.blob.persisted? }.each do |image| %>
        <div class="relative size-20 overflow-hidden rounded-md border border-border bg-background" data-image-preview-target="tile">
          <%= image_tag image.variant(:thumb), alt: item.name, class: "size-full object-cover" %>
          <%= hidden_field_tag "item[images][]", image.signed_id, id: nil %>
          <%= render "photo_tile_controls" %>
        </div>
      <% end %>
    </div>

    <template data-image-preview-target="template">
      <div class="relative size-20 overflow-hidden rounded-md border border-border bg-background" data-image-preview-target="tile">
        <img class="size-full object-cover" alt="">
        <%= render "photo_tile_controls" %>
      </div>
    </template>

    <label
      class="flex cursor-pointer flex-col items-center gap-3 rounded-lg border-2 border-dashed border-input bg-background px-6 py-8 text-center transition-colors focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-ring hover:border-primary data-dragging:border-primary data-dragging:bg-primary/5"
      data-image-preview-target="dropzone"
      data-action="dragover->image-preview#dragOver dragleave->image-preview#dragLeave drop->image-preview#drop"
    >
      <span class="flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary">
        <%= render_svg("photo.svg", styles: "size-5") %>
      </span>

      <span class="text-sm text-foreground/70">
        Arrastra tus fotos o <span class="font-medium text-primary">explora archivos</span>
      </span>

      <span class="text-xs text-foreground/50">PNG, JPG o WebP · hasta 10 MB cada una</span>

      <%= form.file_field :images,
        multiple: true,
        accept: Item::IMAGE_TYPES.join(","),
        class: "sr-only",
        data: { image_preview_target: "input", action: "change->image-preview#select" } %>
    </label>

    <p class="hidden text-xs font-medium text-destructive" data-image-preview-target="error" role="alert"></p>
  </section>

  <%= render Button::Component.new(
    text: item.new_record? ? "Agregar platillo" : "Guardar cambios",
    type: "submit",
    size: :lg,
    full_width: true,
    data: { turbo_submits_with: "Guardando…" },
  ) %>
<% end %>
