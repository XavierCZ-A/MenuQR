<%# locals: (title:, eyebrow: "Platillos") %>
<div class="mx-auto mb-6 flex max-w-xl items-center gap-3">
  <%= render Button::Component.new(
    variant: :outline,
    size: :sm,
    icon_only: true,
    href: admin_root_path,
    icon: render_svg("chevron_left.svg", styles: "size-full"),
    title: "Volver al dashboard",
