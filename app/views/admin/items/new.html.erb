<% content_for :title, "Nuevo producto" %>

<main class="min-h-screen bg-background">
  <header class="border-b border-border bg-card px-4 md:px-8">
    <div class="mx-auto flex h-20 max-w-5xl items-center gap-4">
      <%#
        render Buttons::Component.new(
            variant: :outline,
            icon_only: true,
            icon: render_svg("chevron_left.svg", styles: "h-4 w-4"),
            href: admin_products_path,
        )
      %>

      <div>
        <%= render Breadcrumb::Component.new(
          items: [
            { label: "Platillos", href: admin_items_path },
            { label: "Nuevo platillo", href: new_admin_item_path },
          ],
          separator: :chevron
        ) %>

        <h1 class="text-xl font-bold text-primary">Nuevo platillo</h1>
      </div>
    </div>
  </header>

  <div class="mx-auto max-w-5xl px-4 py-8 md:px-8">
    <%= render partial: "form", locals: { item: @item, categories: @categories } %>
  </div>
</main>
