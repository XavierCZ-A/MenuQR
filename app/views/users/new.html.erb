<% content_for :title, "Registrarse | MenuQr" %>

<% if @user.errors.any? %>
  <div class="mb-5 rounded-lg border border-destructive/30 bg-destructive/10 px-4 py-3">
    <div class="mb-1.5 flex items-center gap-2">
      <%= render_svg("exclamation_circle.svg", styles: "size-5 shrink-0 text-destructive") %>
      <span class="text-sm font-semibold text-foreground">No se pudo crear la cuenta</span>
    </div>

    <ul class="space-y-0.5 pl-6">
      <% @user.errors.full_messages.each do |message| %>
        <li class="list-disc text-xs text-foreground/80"><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="mb-8">
  <h1 class="text-2xl font-bold">
    Registrate
  </h1>

  <div class="flex items-center">
    <p class="text-base">¿Ya tienes cuenta?</p>

    <%= render Button::Component.new(
      text: "Inicia sesion",
      variant: :link,
      size: :md,
      href: new_session_path,
    ) %>
  </div>
</div>

<%= form_with(model: @user, class: "w-full") do |form| %>
  <div class="mb-5">
    <div class="mb-2">
      <label class="text-sm font-medium text-foreground" for="restaurant_name">Nombre del restaurante</label>
      <span class="ml-0.5 text-destructive">*</span>
    </div>

    <%= form.fields_for :restaurants do |rf| %>
      <%= rf.text_field :name,
        placeholder: "Nombre del restaurante",
        required: true,
        class: "block h-10 w-full rounded-lg border border-input bg-background px-3 py-2 text-sm text-foreground placeholder:text-foreground/50 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-50" %>
    <% end %>
  </div>

  <div class="mb-5">
    <%= render Input::Component.new(
      name: "user[email_address]",
      type: :email,
      value: @user.email_address,
      label: "Correo Electrónico",
      placeholder: "example@email.com",
      required: true,
    ) %>
  </div>

  <div class="mb-8">
    <%= render Password::Component.new(
      id: "password",
      label: "Contraseña",
      required: true,
      name: "user[password]",
      placeholder: "••••••••",
    ) %>
  </div>

  <%= render Button::Component.new(
    text: "Registrarse",
    type: "submit",
    full_width: true,
  ) %>
<% end %>
