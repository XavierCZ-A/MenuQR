<div class="space-y-2">
  <% if label.present? %>
    <%= label_tag select_id, class: "block text-sm font-medium text-foreground" do %>
      <%= label %>

      <% if required %>
        <span class="ml-0.5 text-destructive" aria-hidden="true">*</span>
      <% end %>
    <% end %>
  <% end %>

  <%= select_tag @name, option_tags, tag_attributes %>
</div>
