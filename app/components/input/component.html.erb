<div class="space-y-2">
  <% if label.present? %>
    <%= label_tag input_id, class: "block text-sm font-medium text-foreground" do %>
      <%= label %>

      <% if @required %>
        <span class="ml-0.5 text-destructive">*</span>
      <% end %>
    <% end %>
  <% end %>

  <%= tag.input(**tag_attributes) %>
</div>
